    classDef integration fill:#cffafe,stroke:#0891b2,color:#164e63
    classDef data fill:#dcfce7,stroke:#16a34a,color:#14532d

    class POLICY,AUDIT security
    class REGISTRY,EXECUTOR,ERP,CRM,FIN integration
