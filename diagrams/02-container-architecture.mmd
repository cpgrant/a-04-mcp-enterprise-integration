flowchart TB

    AGENT["Agent / MCP Host"]

    subgraph CLIENT["MCP Client Layer"]
        DISCOVERY["Tool Discovery"]
        INVOCATION["Tool Invocation"]
    end

    subgraph SERVER["Enterprise MCP Server"]
        REGISTRY["Tool & Resource Registry"]
        POLICY["Authorization & Policy"]
        EXECUTOR["Tool Executor"]
        AUDIT["Audit & Observability"]
    end

    subgraph ADAPTERS["Enterprise Adapters"]
        ERP["ERP Adapter"]
        CRM["CRM Adapter"]
        FIN["Finance Adapter"]
    end

    subgraph SYSTEMS["Data Sources"]
        ERPDB[("ERP Data")]
        CRMDB[("CRM Data")]
        FINDB[("Finance Data")]
    end

    AGENT --> DISCOVERY
    AGENT --> INVOCATION

    DISCOVERY <--> REGISTRY
    INVOCATION --> POLICY

    POLICY -->|Allow| EXECUTOR
    POLICY -->|Record decision| AUDIT

    EXECUTOR --> ERP
    EXECUTOR --> CRM
    EXECUTOR --> FIN

    ERP --> ERPDB
    CRM --> CRMDB
    FIN --> FINDB

    EXECUTOR --> AUDIT

